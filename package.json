{
  "name": "vscode-dsh",
  "displayName": "dsh · DeepSeek Harness Agent for VSCode",
  "description": "VSCode 与 dsh Agent Daemon 的联动：上下文捕获、流式推理、工具审批与原生 Diff 审查。",
  "version": "0.8.2",
  "publisher": "LSY456",
  "icon": "resources/dsh-icon.png",
  "galleryBanner": {
    "color": "#16307A",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LSY456/vscode-dsh.git"
  },
  "homepage": "https://github.com/LSY456/vscode-dsh#readme",
  "bugs": {
    "url": "https://github.com/LSY456/vscode-dsh/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "受限模式（工作区未被信任）下允许激活 —— 面板要能打开、要能说清「为什么不能用」并给出信任入口；但本地 daemon 不会被启动：它会读写工作区文件、执行命令，并在 .dsh/ 下落盘会话记录。",
      "restrictedConfigurations": [
        "dsh.daemon.mode",
        "dsh.daemon.command",
        "dsh.daemon.port",
        "dsh.daemon.token",
        "dsh.capabilities.allowedTools",
        "dsh.model.baseURL",
        "dsh.apiKey"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Agent 需要真实文件系统：读取工作区文件、应用补丁、在 .dsh/ 下落盘会话历史与轨迹。"
    }
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "deepseek",
    "ai",
    "agent",
    "llm",
    "assistant",
    "code-assistant",
    "chat"
  ],
  "activationEvents": [
    "onView:dsh.agentView",
    "onCommand:dsh.openPanel",
    "onCommand:dsh.openEditor",
    "onCommand:dsh.newSession",
    "onCommand:dsh.rollbackSession",
    "onCommand:dsh.sendSelection",
    "onCommand:dsh.daemon.restart",
    "onCommand:dsh.daemon.status",
    "onCommand:dsh.debug.captureContext"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh",
          "title": "dsh Agent",
          "icon": "resources/dsh-activity.svg"
        }
      ]
    },
    "views": {
      "dsh": [
        {
          "id": "dsh.agentView",
          "name": "Agent",
          "type": "webview",
          "contextualTitle": "dsh Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh.openPanel",
        "category": "dsh",
        "title": "打开 Agent 面板"
      },
      {
        "command": "dsh.sendSelection",
        "category": "dsh",
        "title": "将选中代码发送给 Agent"
      },
      {
        "command": "dsh.daemon.restart",
        "category": "dsh",
        "title": "重启 Daemon"
      },
      {
        "command": "dsh.daemon.status",
        "category": "dsh",
        "title": "查看 Daemon 状态"
      },
      {
        "command": "dsh.trustWorkspace",
        "category": "dsh",
        "title": "信任此工作区（启用 Agent）",
        "enablement": "!isWorkspaceTrusted"
      },
      {
        "command": "dsh.diff.accept",
        "category": "dsh",
        "title": "应用此补丁",
        "icon": "$(check)"
      },
      {
        "command": "dsh.diff.reject",
        "category": "dsh",
        "title": "拒绝此补丁",
        "icon": "$(x)"
      },
      {
        "command": "dsh.diff.applyEdited",
        "category": "dsh",
        "title": "应用 Diff 中的编辑（编辑后应用）",
        "icon": "$(edit)"
      },
      {
        "command": "dsh.debug.captureContext",
        "category": "dsh",
        "title": "调试 - 打印捕获的上下文"
      },
      {
        "command": "dsh.newSession",
        "category": "dsh",
        "title": "新建会话",
        "icon": "$(add)"
      },
      {
        "command": "dsh.rollbackSession",
        "category": "dsh",
        "title": "回滚本次会话的文件改动",
        "icon": "$(discard)"
      },
      {
        "command": "dsh.openEditor",
        "category": "dsh",
        "title": "在编辑器列打开 Agent",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dsh.sendSelection",
          "when": "editorHasSelection",
          "group": "navigation@100"
        }
      ],
      "view/title": [
        {
          "command": "dsh.newSession",
          "when": "view == dsh.agentView",
          "group": "navigation@1"
        },
        {
          "command": "dsh.openEditor",
          "when": "view == dsh.agentView",
          "group": "navigation@2"
        },
        {
          "command": "dsh.rollbackSession",
          "comment": "P2-6 会话回滚：破坏性操作，入口放视图标题栏（点击后有模态确认，误点不会直接执行）",
          "when": "view == dsh.agentView",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "dsh.diff.accept",
          "when": "resourceScheme == dsh-patch",
          "group": "navigation@1"
        },
        {
          "command": "dsh.diff.applyEdited",
          "when": "resourceScheme == dsh-patch",
          "group": "navigation@2"
        },
        {
          "command": "dsh.diff.reject",
          "when": "resourceScheme == dsh-patch",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "dsh.debug.captureContext",
          "comment": "调试命令：只在排障时用，不该占据命令面板的搜索位",
          "when": "false"
        },
        {
          "command": "dsh.diff.accept",
          "comment": "补丁操作只在补丁 Diff 打开时才可调用（没补丁时点了没反应 = 假入口）",
          "when": "resourceScheme == dsh-patch"
        },
        {
          "command": "dsh.diff.applyEdited",
          "when": "resourceScheme == dsh-patch"
        },
        {
          "command": "dsh.diff.reject",
          "when": "resourceScheme == dsh-patch"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dsh.openPanel",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      },
      {
        "command": "dsh.sendSelection",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "dsh Agent",
      "properties": {
        "dsh.daemon.mode": {
          "type": "string",
          "enum": [
            "auto",
            "external",
            "none"
          ],
          "enumDescriptions": [
            "自动：探测已有 daemon，否则拉起内置参考 daemon",
            "外部：连接一个已在运行的手动启动的 daemon（需配置 port/token）",
            "不启动 daemon，仅 UI（调试用）"
          ],
          "default": "auto",
          "scope": "machine",
          "description": "dsh daemon 的运行模式。机器作用域：指向哪个 daemon 决定了信任谁，不能由工作区设置改写。"
        },
        "dsh.daemon.command": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "外部 daemon 启动命令模板（auto 模式也优先使用它）。留空则使用插件内置的参考 daemon。机器作用域：这是会被当作可执行文件直接启动的字符串，绝不允许工作区设置改写（否则打开恶意仓库即等于执行任意进程）。"
        },
        "dsh.daemon.port": {
          "type": "number",
          "default": 0,
          "scope": "machine",
          "description": "external 模式下的 daemon 端口（0 表示从端口文件中读取）。机器作用域：决定连到哪个 daemon。"
        },
        "dsh.daemon.token": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "external 模式下的握手令牌。留空时使用插件生成的随机令牌（需与 daemon 端一致）。机器作用域：属于凭据，不接受工作区设置下发的值。"
        },
        "dsh.apiKey": {
          "type": "string",
          "default": "",
          "description": "【已弃用】模型 API Key 的旧明文存放位置。",
          "deprecationMessage": "请勿在此填写：模型 Key 现存放于系统密钥库（SecretStorage），通过面板「设置」写入。保留此项仅用于首次启动时把旧明文自动迁移一次（迁移后会被清除）；机器作用域之外的工作区设置一律不被接受。"
        },
        "dsh.preset": {
          "type": "string",
          "enum": [
            "default"
          ],
          "enumDescriptions": [
            "缺省档位：不做额外行为调整（当前唯一可选值）"
          ],
          "default": "default",
          "description": "Agent 预设：握手时交给 daemon 的行为档位名（不是模型名）。当前 daemon 只提供 default 一档，保持缺省即可。"
        },
        "dsh.model.baseURL": {
          "type": "string",
          "default": "https://api.deepseek.com/v1",
          "description": "模型 API 端点 base（OpenAI 兼容协议）。留空或保持此缺省值时，若 dsh.model.provider 为 anthropic 会自动改用 Anthropic 官方端点（不会把 DeepSeek 地址发给 Claude 通道）；一旦填了别的地址，则一律以填的为准。"
        },
        "dsh.model.model": {
          "type": "string",
          "default": "deepseek-flash",
          "description": "模型名。推荐在侧边栏「模型设置」里从下拉选择（列表会自动跟随 DeepSeek 官方更新）；手写请注意旧名 deepseek-chat / deepseek-reasoner 已于 2026/07/24 弃用。"
        },
        "dsh.model.provider": {
          "type": "string",
          "enum": [
            "auto",
            "openai",
            "anthropic"
          ],
          "default": "auto",
          "description": "模型 provider：auto/openai（OpenAI 兼容，含 DeepSeek/通义/本地推理等）、anthropic（Claude Messages）。"
        },
        "dsh.model.idleTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 1800,
          "description": "模型请求空闲超时（秒）：距上一个流式增量超过该时长即中断本次请求，避免模型端静默时会话永久挂起；0 表示关闭。"
        },
        "dsh.model.temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "采样温度（0–2）：数字越小，回答越稳定、越保守；数字越大，回答越随机、越有发挥空间。不确定就留空，使用内置缺省 0.2。注意 Anthropic 的合法区间是 0–1，超出部分会被钳制到 1。"
        },
        "dsh.model.maxTokens": {
          "type": "number",
          "minimum": 1,
          "maximum": 131072,
          "description": "单次输出上限（max_tokens）。留空 = 不发送该字段，由服务端决定上限（OpenAI 兼容端点）；Anthropic 把 max_tokens 列为必填，留空时回落到 4096。"
        },
        "dsh.agent.maxToolRounds": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 50,
          "description": "工具调用轮数上限：一次对话里最多连续调用多少次工具。用尽后 Agent 会自动收束成一次「不能再调用工具」的最终回答。调大可处理更复杂的任务，但更耗 token。"
        },
        "dsh.agent.maxContextTokens": {
          "type": "number",
          "default": 49152,
          "minimum": 4000,
          "maximum": 1000000,
          "description": "上下文 token 预算：发送前按此估算并裁剪历史，超出时整轮丢弃最旧的工具轮次。调小可省 token，调大能带上更长的上下文。"
        },
        "dsh.agent.maxWriteFailures": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 20,
          "description": "写入类工具连续失败多少次就停止尝试：只统计「写入文件 / 修改文件」的系统侧失败（路径越界、原文未匹配、文件被改动、读写错误）。一次写入成功即清零。命令执行的失败与你的拒绝都不计入 —— 命令非零退出是正常信息（如 grep 无匹配），计入会让正常提问被误判为故障。"
        },
        "dsh.context.gitStatus": {
          "type": "boolean",
          "default": true,
          "description": "发送 Prompt 时附带 git status 摘要（需要 git 可用，失败则静默跳过）。"
        },
        "dsh.context.maxFileBytes": {
          "type": "number",
          "default": 200000,
          "description": "作为附件发送的文件内容上限（字节），超出部分截断。"
        },
        "dsh.diff.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "daemon 发出 file.patch.pending 时自动打开原生 Diff 视图。"
        },
        "dsh.log.level": {
          "type": "string",
          "enum": [
            "info",
            "debug"
          ],
          "default": "info",
          "description": "扩展日志级别。"
        },
        "dsh.capabilities.allowedTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "允许 daemon 使用的工具白名单（如 bash_execute）；空数组 = 全部允许。"
        },
        "dsh.capabilities.maxConcurrency": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "daemon 全局并发会话上限；0 = 不限制。"
        },
        "dsh.approval.ttlSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 3600,
          "description": "工具审批 / 文件补丁挂起的超时秒数：超过该时间未响应按拒绝处理。修改后需重启 daemon 生效。"
        },
        "dsh.history.maxSessions": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "maximum": 10000,
          "description": "会话历史保留条数（面板「历史」列表与 .dsh/history.json）：超出后按创建时间裁剪最旧的；0 = 不限制。历史含对话全文，长期使用会持续增长，故设缺省上限。"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:check": "npm run typecheck && npm run build",
    "test": "vitest run --pool=threads",
    "test:watch": "vitest",
    "smoke": "node esbuild.js && node scripts/smoke.js",
    "smoke:protocol": "node scripts/smokeProtocol.js",
    "smoke:real": "node esbuild.js && node scripts/smokeReal.js",
    "test:integration": "node scripts/runIntegrationTests.js",
    "check": "npm run check:workflows && npm run typecheck && npm run build && npm test && npm run smoke && npm run check:package",
    "check:package": "node scripts/checkPackage.js",
    "check:workflows": "node scripts/checkWorkflows.js",
    "package": "vsce package --out dist",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "dompurify": "^3.4.13",
    "esbuild": "^0.28.2",
    "glob": "^13.0.6",
    "highlight.js": "^11.12.0",
    "jsdom": "^29.1.1",
    "marked": "^18.0.9",
    "mocha": "^11.8.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
