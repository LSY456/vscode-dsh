{
  "name": "vscode-dsh",
  "displayName": "dsh · DeepSeek Harness Agent for VSCode",
  "description": "VSCode 与 dsh Agent Daemon 的联动：上下文捕获、流式推理、工具审批与原生 Diff 审查。",
  "version": "0.4.4",
  "publisher": "deepseek-ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LSY456/vscode-dsh.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onView:dsh.agentView",
    "onCommand:dsh.openPanel",
    "onCommand:dsh.openEditor",
    "onCommand:dsh.newSession",
    "onCommand:dsh.sendSelection",
    "onCommand:dsh.daemon.restart",
    "onCommand:dsh.daemon.status",
    "onCommand:dsh.debug.captureContext"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh",
          "title": "dsh Agent",
          "icon": "resources/dsh-activity.svg"
        }
      ]
    },
    "views": {
      "dsh": [
        {
          "id": "dsh.agentView",
          "name": "Agent",
          "type": "webview",
          "contextualTitle": "dsh Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh.openPanel",
        "title": "dsh: 打开 Agent 面板"
      },
      {
        "command": "dsh.sendSelection",
        "title": "dsh: 将选中代码发送给 Agent"
      },
      {
        "command": "dsh.daemon.restart",
        "title": "dsh: 重启 Daemon"
      },
      {
        "command": "dsh.daemon.status",
        "title": "dsh: 查看 Daemon 状态"
      },
      {
        "command": "dsh.diff.accept",
        "title": "dsh: 应用此补丁",
        "icon": "$(check)"
      },
      {
        "command": "dsh.diff.reject",
        "title": "dsh: 拒绝此补丁",
        "icon": "$(x)"
      },
      {
        "command": "dsh.diff.applyEdited",
        "title": "dsh: 应用 Diff 中的编辑（编辑后应用）",
        "icon": "$(edit)"
      },
      {
        "command": "dsh.debug.captureContext",
        "title": "dsh: 调试 - 打印捕获的上下文"
      },
      {
        "command": "dsh.newSession",
        "title": "dsh: 新建会话",
        "icon": "$(add)"
      },
      {
        "command": "dsh.openEditor",
        "title": "dsh: 在编辑器列打开 Agent",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dsh.sendSelection",
          "when": "editorHasSelection",
          "group": "navigation@100"
        }
      ],
      "view/title": [
        {
          "command": "dsh.newSession",
          "when": "view == dsh.agentView",
          "group": "navigation@1"
        },
        {
          "command": "dsh.openEditor",
          "when": "view == dsh.agentView",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "dsh.diff.accept",
          "when": "resourceScheme == dsh-patch",
          "group": "navigation@1"
        },
        {
          "command": "dsh.diff.applyEdited",
          "when": "resourceScheme == dsh-patch",
          "group": "navigation@2"
        },
        {
          "command": "dsh.diff.reject",
          "when": "resourceScheme == dsh-patch",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "dsh Agent",
      "properties": {
        "dsh.daemon.mode": {
          "type": "string",
          "enum": [
            "auto",
            "external",
            "none"
          ],
          "enumDescriptions": [
            "自动：探测已有 daemon，否则拉起内置参考 daemon",
            "外部：连接一个已在运行的手动启动的 daemon（需配置 port/token）",
            "不启动 daemon，仅 UI（调试用）"
          ],
          "default": "auto",
          "description": "dsh daemon 的运行模式。"
        },
        "dsh.daemon.command": {
          "type": "string",
          "default": "",
          "description": "外部 daemon 启动命令模板（auto 模式也优先使用它）。留空则使用插件内置的参考 daemon。"
        },
        "dsh.daemon.port": {
          "type": "number",
          "default": 0,
          "description": "external 模式下的 daemon 端口（0 表示从端口文件中读取）。"
        },
        "dsh.daemon.token": {
          "type": "string",
          "default": "",
          "description": "external 模式下的握手令牌。留空时使用插件生成的随机令牌（需与 daemon 端一致）。"
        },
        "dsh.apiKey": {
          "type": "string",
          "default": "",
          "description": "传给 daemon 的模型 API Key（daemon 端可忽略）。"
        },
        "dsh.preset": {
          "type": "string",
          "default": "default",
          "description": "daemon 端使用的 Agent 预设名。"
        },
        "dsh.model.baseURL": {
          "type": "string",
          "default": "https://api.deepseek.com/v1",
          "description": "模型 API 端点 base（OpenAI 兼容协议）。"
        },
        "dsh.model.model": {
          "type": "string",
          "default": "deepseek-chat",
          "description": "模型名（如 deepseek-chat / deepseek-reasoner）。"
        },
        "dsh.model.provider": {
          "type": "string",
          "enum": [
            "auto",
            "openai",
            "anthropic"
          ],
          "default": "auto",
          "description": "模型 provider：auto/openai（OpenAI 兼容，含 DeepSeek/通义/本地推理等）、anthropic（Claude Messages）。"
        },
        "dsh.model.idleTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 1800,
          "description": "模型请求空闲超时（秒）：距上一个流式增量超过该时长即中断本次请求，避免模型端静默时会话永久挂起；0 表示关闭。"
        },
        "dsh.context.gitStatus": {
          "type": "boolean",
          "default": true,
          "description": "发送 Prompt 时附带 git status 摘要（需要 git 可用，失败则静默跳过）。"
        },
        "dsh.context.maxFileBytes": {
          "type": "number",
          "default": 200000,
          "description": "作为附件发送的文件内容上限（字节），超出部分截断。"
        },
        "dsh.diff.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "daemon 发出 file.patch.pending 时自动打开原生 Diff 视图。"
        },
        "dsh.log.level": {
          "type": "string",
          "enum": [
            "info",
            "debug"
          ],
          "default": "info",
          "description": "扩展日志级别。"
        },
        "dsh.capabilities.allowedTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "允许 daemon 使用的工具白名单（如 bash_execute）；空数组 = 全部允许。"
        },
        "dsh.capabilities.maxConcurrency": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "daemon 全局并发会话上限；0 = 不限制。"
        },
        "dsh.approval.ttlSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 3600,
          "description": "工具审批 / 文件补丁挂起的超时秒数：超过该时间未响应按拒绝处理。修改后需重启 daemon 生效。"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:check": "npm run typecheck && npm run build",
    "test": "vitest run --pool=threads",
    "test:watch": "vitest",
    "smoke": "node esbuild.js && node scripts/smoke.js",
    "smoke:protocol": "node scripts/smokeProtocol.js",
    "smoke:real": "node esbuild.js && node scripts/smokeReal.js",
    "test:integration": "node scripts/runIntegrationTests.js",
    "check": "npm run typecheck && npm run build && npm test && npm run smoke",
    "package": "vsce package --out dist",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "dompurify": "^3.4.13",
    "esbuild": "^0.28.2",
    "glob": "^13.0.6",
    "highlight.js": "^11.12.0",
    "jsdom": "^29.1.1",
    "marked": "^18.0.9",
    "mocha": "^11.8.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
