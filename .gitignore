# ================= 依赖 =================
node_modules/

# ================= 构建产物（esbuild 输出：扩展宿主 / 参考 daemon / webview 副本） =================
out/
out-tsc/

# ================= 本地 npm 缓存（安装时可能重定向到工作区） =================
.npm-cache/

# ================= dsh daemon 运行时状态（端口文件 .dsh/daemon.json 等，写入工作区根目录） =================
.dsh/

# ================= VSIX 打包产物（vsce --out dist 输出为名为 dist 的文件） =================
dist
*.vsix

# ================= 测试产物与覆盖率 =================
coverage/
.nyc_output/
*.tsbuildinfo

# ================= 日志 =================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ================= 编辑器 / IDE =================
.vscode-test/
.idea/
*.iml
*.swp
*.swo

# ================= 操作系统 =================
.DS_Store
Thumbs.db
desktop.ini

# ================= 临时文件 =================
*.tmp
*.temp

# ================= AI 工作区记忆（本地会话记录，不入库） =================
.workbuddy/
